# Public browser configuration
VITE_WEB3FORMS_ACCESS_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shared server-side Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WA_BOT_LOGS_KEY=
WA_PRODUCT_IMAGE_BUCKET=wa-product-images

# Primary WhatsApp connection
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_BUSINESS_ID=double-a-test-business

# Additional legacy WhatsApp connection suffixes, comma separated
WHATSAPP_CONNECTION_SUFFIXES=2
WHATSAPP_ACCESS_TOKEN_2=
WHATSAPP_PHONE_NUMBER_ID_2=
WHATSAPP_BUSINESS_ACCOUNT_ID_2=
WHATSAPP_VERIFY_TOKEN_2=
WHATSAPP_APP_SECRET_2=
WHATSAPP_GRAPH_API_VERSION_2=
WHATSAPP_BUSINESS_ID_2=double-a-partner-test-business

# Primary client workspace login
WA_DASHBOARD_USERNAME=owner
WA_DASHBOARD_PASSWORD=
WA_DASHBOARD_SESSION_SECRET=
WA_DASHBOARD_BUSINESS_ID=double-a-test-business

# Partner client workspace login
WA_DASHBOARD_USERNAME_2=owner
WA_DASHBOARD_PASSWORD_2=
WA_DASHBOARD_SESSION_SECRET_2=
WA_DASHBOARD_BUSINESS_ID_2=double-a-partner-test-business

# Internal Double A admin login
WA_INTERNAL_ADMIN_USERNAME=admin
WA_INTERNAL_ADMIN_PASSWORD=
WA_INTERNAL_ADMIN_SESSION_SECRET=

# Default-off production control for human-authored WhatsApp replies.
CONNECT_HUMAN_SEND_ENABLED=false
# Optional bearer secret for Connect maintenance workers. The human-specific
# alias remains supported during the rollout.
CONNECT_WORKER_SECRET=
CONNECT_HUMAN_WORKER_SECRET=
WA_INTERNAL_REVIEWER_USERNAME=
WA_INTERNAL_REVIEWER_PASSWORD=

# Optional owner notification delivery
PUBLIC_SITE_URL=https://doubleacode.com
OWNER_EMAIL_PROVIDER_URL=
OWNER_EMAIL_API_KEY=

# Desktop-app license switch (see docs/license/README.md). Server-only secrets: never VITE_ prefixed.
# Ed25519 private key, base64 PKCS#8, written to a file by tools/license-server/generate-keypair.cjs in the app repo.
LICENSE_SIGNING_PRIVATE_KEY=
# Long random token (32+ characters) that unlocks /license-admin. Without it the admin switch is disabled.
LICENSE_ADMIN_TOKEN=
# Optional tuning: hours an "active" answer keeps a client working offline, and the check-in interval.
LICENSE_GRACE_HOURS=72
LICENSE_CHECK_INTERVAL_SEC=3600
# Local development only (ignored in production): LICENSE_STORE=memory
